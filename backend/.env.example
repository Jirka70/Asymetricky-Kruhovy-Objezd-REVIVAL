DATABASE_URL=postgres://obor:CHANGE_ME@127.0.0.1:5432/obor_na_dosah
BIND_ADDRESS=127.0.0.1:8000
DB_POOL_SIZE=8
RUST_LOG=obor_backend=info

# GTFS GraphQL endpoint; Compose defaults to http://otp:8080/otp/gtfs/v1.
OTP_URL=http://localhost:8080/otp/gtfs/v1
# Optional fixed timetable date (YYYY-MM-DD); blank selects the next weekday morning.
OTP_SERVICE_DATE=
